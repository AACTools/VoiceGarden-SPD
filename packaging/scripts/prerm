#!/bin/sh
# prerm — unregister the module on package removal (not upgrade).
#
# Used by both .deb and .rpm (nfpm preremove). POSIX sh only.
#   deb prerm:  $1 = remove | upgrade | ...
#   rpm %preun: $1 = 0 (erase) | 1 (upgrade) — 0 means "erase"

set -e

CONF="${VGSPD_CONF:-/etc/speech-dispatcher/speechd.conf}"

case "${1:-}" in
    remove|0|erase)
        if [ -f "$CONF" ]; then
            tmp=$(mktemp)
            grep -v 'AddModule "voicegarden-spd"' "$CONF" > "$tmp" || true
            # cat > keeps ownership/permissions of the original
            cat "$tmp" > "$CONF"
            rm -f "$tmp"
            echo "voicegarden-spd: unregistered module from $CONF"
        fi
        ;;
esac

exit 0
