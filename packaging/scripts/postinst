#!/bin/sh
# postinst — make speech-dispatcher load the module after package install.
#
# Used by both .deb and .rpm (nfpm postinstall). POSIX sh only.
#
# VGSPD_CONF overrides the config path (used by the repo's tests to
# verify this script without touching the real /etc).

set -e

CONF="${VGSPD_CONF:-/etc/speech-dispatcher/speechd.conf}"

# speech-dispatcher >= 0.12 is required (server-side audio + speak queue).
# Warn loudly rather than hard-depend so users on older distros get an
# actionable message instead of a silent runtime failure.
if command -v speech-dispatcher >/dev/null 2>&1; then
    version=$(speech-dispatcher --version 2>/dev/null | head -n1 | awk '{print $2}')
    if [ -n "$version" ]; then
        major=$(printf '%s' "$version" | cut -d. -f1)
        minor=$(printf '%s' "$version" | cut -d. -f2)
        if [ "$(printf '%02d%02d' "${major:-0}" "${minor:-0}")" -lt 0012 ]; then
            echo "voicegarden-spd: WARNING speech-dispatcher $version is installed but" >&2
            echo "  0.12+ is required (server-side audio). The module will load but" >&2
            echo "  speech cannot play. Upgrade speech-dispatcher (e.g. Debian trixie," >&2
            echo "  Ubuntu 25.04+, Fedora 41+), or remove this package." >&2
        fi
    fi
fi

# Registration:
#
# speech-dispatcher auto-detects modules from its module directories while
# NO AddModule line is configured. Appending one to a conf that relies on
# auto-detection would silently drop every other output module (espeak-ng,
# orca's voice, …). So only add an explicit registration when the admin
# already uses AddModule lines; otherwise the packaged
# sd_voicegarden-spd binary is picked up by auto-detection on restart.

found_binary=0
for candidate in \
    /usr/lib/*/speech-dispatcher-modules/sd_voicegarden-spd \
    /usr/lib/speech-dispatcher-modules/sd_voicegarden-spd \
    /usr/lib64/speech-dispatcher-modules/sd_voicegarden-spd
do
    if [ -x "$candidate" ]; then
        found_binary=1
        break
    fi
done

if [ "$found_binary" -ne 1 ]; then
    echo "voicegarden-spd: WARNING sd_voicegarden-spd binary not found where the" >&2
    echo "  package expected it — not registering. Report this as a bug." >&2
    exit 0
fi

if [ ! -f "$CONF" ]; then
    echo "voicegarden-spd: $CONF not found (speech-dispatcher not configured yet?);" >&2
    echo "  the module will be auto-detected once speech-dispatcher is set up." >&2
    exit 0
fi

if grep -Eq '^[[:space:]]*AddModule' "$CONF" 2>/dev/null; then
    # The admin registers modules explicitly (auto-detection is already
    # off) — add ours in the same style.
    if ! grep -q 'AddModule "voicegarden-spd"' "$CONF" 2>/dev/null; then
        printf 'AddModule "voicegarden-spd" "%s" "voicegarden-spd.conf"\n' \
            "$candidate" >> "$CONF"
        echo "voicegarden-spd: registered module in $CONF"
    fi
else
    echo "voicegarden-spd: $CONF relies on module auto-detection — left untouched;"
    echo "  speech-dispatcher will discover sd_voicegarden-spd on restart."
fi

echo
echo "Restart speech-dispatcher to activate (per user session):"
echo "  systemctl --user restart speech-dispatcher.service"
echo "or log out and back in. Then: spd-say -o voicegarden-spd \"Hello\""
echo "Troubleshooting: voicegarden-spd doctor"

exit 0
